{
  "name": "engine-viewer",
  "version": "1.0.0",
  "description": "Interactive 3D engines (Three.js / WebGL) with a React + shadcn/ui interface",
  "private": true,
  "scripts": {
    "css": "tailwindcss -c tailwind.config.js -i css/style.css -o dist/app.css --minify",
    "build": "npm run css && esbuild js/main.js --minify --bundle --format=iife --jsx=automatic --loader:.js=jsx --define:process.env.NODE_ENV=\\\"production\\\" --outfile=dist/app.js",
    "watch": "esbuild js/main.js --sourcemap --bundle --format=iife --jsx=automatic --loader:.js=jsx --define:process.env.NODE_ENV=\\\"production\\\" --outfile=dist/app.js --watch"
  },
  "dependencies": {
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.49.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tailwindcss": "^3.4.19"
  }
}